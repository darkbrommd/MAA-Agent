QWidget {{
    background: {background};
    color: {text};
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
}}
QMainWindow, QDialog {{ background: {background}; }}
QFrame#NavigationRail {{ background: {navigation}; border-right: 1px solid {border}; }}
QFrame#TopStatusBar {{ background: {navigation}; border-bottom: 1px solid {border}; }}
QFrame#Card, QListView, QPlainTextEdit, QTextEdit {{
    background: {card};
    border: 1px solid {border};
    border-radius: 10px;
}}
QPushButton, QToolButton {{
    background: {card};
    border: 1px solid {border};
    border-radius: 8px;
    padding: 7px 12px;
}}
QPushButton:hover, QToolButton:hover {{ border-color: {accent}; }}
QPushButton:pressed, QToolButton:pressed {{ background: {disabled_background}; }}
QPushButton:disabled, QToolButton:disabled {{ color: {disabled_text}; background: {disabled_background}; }}
QPushButton#PrimaryButton {{ background: {accent}; color: white; border-color: {accent}; }}
QPushButton#NavButton {{ text-align: left; padding: 9px 12px; border-color: transparent; background: transparent; }}
QPushButton#NavButton:checked {{ background: {card}; color: {accent}; border-color: {border}; }}
QLabel#MutedLabel {{ color: {muted}; }}
QLabel#SectionLabel {{ color: {muted}; font-size: 11px; font-weight: 600; }}
QLabel#PageTitle {{ font-size: 22px; font-weight: 700; }}
QLabel#StatusPill {{ background: {card}; border: 1px solid {border}; border-radius: 12px; padding: 4px 9px; }}
QLineEdit, QComboBox, QSpinBox, QDateEdit {{ background: {card}; border: 1px solid {border}; border-radius: 7px; padding: 6px 8px; }}
QScrollBar:vertical {{ background: transparent; width: 10px; margin: 2px; }}
QScrollBar::handle:vertical {{ background: {border}; min-height: 30px; border-radius: 4px; }}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
QSplitter::handle {{ background: {border}; }}
QToolTip {{ background: {card}; color: {text}; border: 1px solid {border}; padding: 5px; }}
