{
  "bark_server": "https://api.day.app",
  "bark_key": "REPLACE_WITH_YOUR_BARK_KEY",
  "enable_bark": true,
  "bark_retry_attempts": 3,
  "bark_retry_sleep_seconds": 3,
  "bark_retry_infinite": false,
  "bark_queue_retry_per_loop": 3,
  "bark_queue_max_items": 100,
  "bark_queue_ttl_hours": 6,
  "use_deepseek": false,
  "deepseek_api_key": "",
  "deepseek_model": "deepseek-flash",
  "maa_process_names": ["MAA.exe"],
  "mumu_process_names": [
    "MuMuPlayer.exe",
    "NemuPlayer.exe",
    "MuMuVMMHeadless.exe",
    "MuMuNxMain.exe",
    "MuMuNxDevice.exe",
    "MuMuNxService.exe",
    "MuMuRemoteBackend.exe",
    "MuMuVMMSVC.exe"
  ],
  "maa_instance_dirs": {
    "MAA1": "D:\\MAA\\MAA1",
    "MAA2": "D:\\MAA\\MAA2"
  },
  "maa_instance_aliases": {"MAA1": "", "MAA2": ""},
  "maa_gui_config_paths": {
    "MAA1": "D:\\MAA\\MAA1\\config\\gui.new.json",
    "MAA2": "D:\\MAA\\MAA2\\config\\gui.new.json"
  },
  "maa_log_paths": [
    "D:\\MAA\\MAA1\\debug\\asst.log",
    "D:\\MAA\\MAA2\\debug\\asst.log"
  ],
  "check_interval_seconds": 60,
