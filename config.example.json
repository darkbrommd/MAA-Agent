  "news_cache_limit": 50,
  "news_initial_fetch_count": 20,
  "news_content_fetch_limit": 20,
  "news_check_times": ["00:05", "12:05"],
  "news_keywords": ["闪断更新", "停机维护"],
  "news_maintenance_action": "supervision_only",
  "gui_start_agent_on_launch": true,
  "gui_start_minimized": true,
  "gui_dark_mode": true,
